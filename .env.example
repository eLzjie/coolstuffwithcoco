# ============================================================================
#  Cool Stuff with Coco — environment template
#
#  Copy to .env.local and fill in. NEVER commit .env.local.
#
#  Anything prefixed NEXT_PUBLIC_ is inlined into the client bundle and is
#  PUBLIC. Never put a secret behind that prefix.
# ============================================================================

# ---- Capture mode ----------------------------------------------------------
# "inpage" (default) = the React form posting to /api/subscribe.
# "embed"            = escape hatch, renders the GHL iframe instead.
#
# The embed costs accurate tracking: an iframe submit isn't observable from the
# parent, so `lead` can't fire on real success and Pixel/CAPI can't dedupe on a
# shared eventId. Only flip this if the in-page end-to-end test hasn't passed.
NEXT_PUBLIC_CAPTURE_MODE=inpage

# ---- GoHighLevel (server only — never NEXT_PUBLIC_) ------------------------
# A Private Integration Token, `pit-` prefixed. Needs these scopes:
#   contacts.readonly, contacts.write, locations/customFields.readonly
# It does NOT need locations.readonly.
GHL_API_KEY=
GHL_LOCATION_ID=

# NO WEBHOOK URLS ANY MORE (removed 2026-09-09).
#
# There were three GHL_WEBHOOK_* keys here, one per concept. Delivery now
# triggers on GHL's native Contact Tag instead, watching for
# `lead-magnet-<concept>` — which the contact upsert already applies. So there
# is nothing to configure, and one fewer bearer-equivalent secret to rotate.
#
# Why it changed: an Inbound Webhook trigger doesn't attach a contact to the
# workflow run, so every contact-scoped action was skipped and no guide was
# ever sent, with no error anywhere. See src/app/api/subscribe/route.ts.
#
# If you ever reintroduce a webhook, remember those URLs are bearer-equivalent:
# anyone holding one can trigger the workflow. Never commit them.

# ---- Rate limiting (server only) -------------------------------------------
# Upstash Redis REST credentials. This database is SHARED with the onthetron
# project, so every key this app writes is prefixed `coco:`. If these are
# unset, rate limiting is disabled and a warning is logged.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---- Meta ------------------------------------------------------------------
# Pixel id is public by design — it ships in the client bundle.
# Leave the Pixel ID blank inside the GHL form settings: it's wired at page
# level here, and setting it in both places double-counts every lead.
NEXT_PUBLIC_META_PIXEL_ID=

# Conversions API token. SERVER ONLY. Grants the ability to write conversion
# events for the pixel — treat it like a password.
META_CAPI_ACCESS_TOKEN=

# ---- Guide delivery --------------------------------------------------------
# Hosted PDF URLs.
#
# Delivery is now EMAIL-ONLY: the thank-you page says "check your inbox" and
# does not link the PDF. See SHOW_ON_PAGE_DOWNLOAD in lib/content/library.ts
# for why, and for the quote from the build spec arguing the other way.
#
# Keep these set anyway. The delivery emails hardcode the PDF links, and
# flipping that flag back to true restores the on-page download without any
# other change — which is the intended escape hatch if deliverability bites.
NEXT_PUBLIC_GUIDE_DECODE_URL=
NEXT_PUBLIC_GUIDE_VETBILL_URL=

# ---- Analytics debug -------------------------------------------------------
# Set to 1 to log every tracked event with its full payload to the console,
# so event firing can be verified without opening Events Manager.
NEXT_PUBLIC_ANALYTICS_DEBUG=

# ---- GHL form embeds (only used when NEXT_PUBLIC_CAPTURE_MODE=embed) -------
NEXT_PUBLIC_GHL_FORM_DECODE=
NEXT_PUBLIC_GHL_FORM_VETBILL=
NEXT_PUBLIC_GHL_FORM_NEWSLETTER=

# ---------------------------------------------------------------------------
# Google Analytics 4 + Tag Manager
# ---------------------------------------------------------------------------
# NOT secrets — both ids are visible in the page source of any site using
# them. Set these in the PRODUCTION environment ONLY.
#
# Leave them unset locally, on preview and on staging: unset means the tags
# do not render at all, which is what keeps dev traffic and the API test
# suites out of the one GA4 property the ad spend is judged on. track() still
# logs every event under NEXT_PUBLIC_ANALYTICS_DEBUG=1 with these empty.
#
# Production values are recorded in src/lib/analytics/ids.ts.
#
# WARNING: do NOT add a GA4 Configuration tag to the GTM container. GA4 is
# loaded directly via gtag.js, and having both counts every hit twice with no
# error anywhere. See src/components/analytics/Tags.tsx.
NEXT_PUBLIC_GA4_ID
NEXT_PUBLIC_GTM_ID

# Microsoft Clarity is NOT configured here. It lives in the GTM container
# (project yff7ashiza, loaded as clarity.ms/tag/...?ref=gtm). Do not add a
# second install in this codebase — two recorders on one page means doubled
# sessions. See the note in src/lib/analytics/ids.ts.
