# ============================================================================
#  Cool Things with Coco — environment template
#
#  Copy to .env.local and fill in. NEVER commit .env.local.
#
#  Anything prefixed NEXT_PUBLIC_ is inlined into the client bundle and is
#  PUBLIC. Never put a secret behind that prefix.
# ============================================================================

# ---- GoHighLevel form embeds -----------------------------------------------
# Public form URLs from the GHL sub-account. When set, GhlFormEmbed renders the
# real iframe; when blank it renders a labelled placeholder.
# Email field only — every extra field costs conversion rate.
NEXT_PUBLIC_GHL_FORM_DECODE=
NEXT_PUBLIC_GHL_FORM_VETBILL=
NEXT_PUBLIC_GHL_FORM_NEWSLETTER=

# ---- Guide delivery --------------------------------------------------------
# Hosted PDF URLs. We deliver by URL because GHL's native file delivery is
# unreliable. Until these are set the thank-you download buttons are disabled
# with a visible placeholder rather than linking to a 404.
NEXT_PUBLIC_GUIDE_DECODE_URL=
NEXT_PUBLIC_GUIDE_VETBILL_URL=

# ---- Analytics -------------------------------------------------------------
# Set to 1 to log every tracked event and its full payload to the console.
# Lets you verify the event vocabulary without opening Events Manager.
NEXT_PUBLIC_ANALYTICS_DEBUG=

# Meta Pixel id. Public by design — it ships in the client bundle.
# The Pixel script must load from behind the consent gate. See lib/consent.ts.
NEXT_PUBLIC_META_PIXEL_ID=

# ---- Server-only. NOT NEXT_PUBLIC_. Never expose these. --------------------
# Needed only once the in-page form replaces the GHL iframe embed and
# /api/subscribe exists. Not used by the current build.
#
# META_CAPI_ACCESS_TOKEN=
# GHL_API_KEY=
# GHL_LOCATION_ID=
